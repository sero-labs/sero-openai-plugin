{
  "name": "@sero-ai/plugin-openai-extender",
  "version": "0.2.0",
  "description": "Optional OpenAI model enhancements for Sero",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "sero-plugin",
    "openai"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && vite build && npm run build:extension",
    "build:extension": "esbuild extension/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/extension/index.js --external:@earendil-works/pi-agent-core --external:@earendil-works/pi-ai --external:@earendil-works/pi-coding-agent",
    "test": "vitest run --root .",
    "typecheck": "tsc --noEmit -p ui/tsconfig.json && tsc --noEmit -p extension/tsconfig.json",
    "pack:test": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./dist/extension/index.js"
    ]
  },
  "sero": {
    "app": {
      "id": "openai-extender",
      "scope": "global",
      "styleIsolation": "scope",
      "name": "OpenAI Model Enhancements",
      "icon": "bot",
      "ui": "./dist/ui/remoteEntry.js",
      "component": "OpenAIApp",
      "devPort": 5200,
      "contributes": {
        "components": [
          {
            "id": "openai-model-settings",
            "extensionPoint": "ui.admin.model-settings",
            "name": "OpenAI",
            "component": "OpenAIModelSettings",
            "description": "Optional behavior for compatible OpenAI models",
            "icon": "bot"
          },
          {
            "id": "openai-chat-shortcut",
            "extensionPoint": "ui.chat.model-extension",
            "component": "OpenAIChatShortcut",
            "models": [
              {
                "provider": "openai",
                "api": "openai-responses",
                "modelId": "gpt-5.4"
              },
              {
                "provider": "openai",
                "api": "openai-responses",
                "modelId": "gpt-5.3-codex"
              },
              {
                "provider": "openai",
                "api": "openai-responses",
                "modelId": "gpt-4.1"
              },
              {
                "provider": "openai-codex",
                "api": "openai-codex-responses",
                "modelId": "gpt-5.3-codex-spark"
              },
              {
                "provider": "openai-codex",
                "api": "openai-codex-responses",
                "modelId": "gpt-5.4"
              },
              {
                "provider": "openai-codex",
                "api": "openai-codex-responses",
                "modelId": "gpt-5.4-mini"
              },
              {
                "provider": "openai-codex",
                "api": "openai-codex-responses",
                "modelId": "gpt-5.5"
              },
              {
                "provider": "openai-codex",
                "api": "openai-codex-responses",
                "modelId": "gpt-5.6-luna"
              },
              {
                "provider": "openai-codex",
                "api": "openai-codex-responses",
                "modelId": "gpt-5.6-sol"
              },
              {
                "provider": "openai-codex",
                "api": "openai-codex-responses",
                "modelId": "gpt-5.6-terra"
              }
            ]
          }
        ]
      }
    },
    "plugin": {
      "category": "integrations",
      "tags": [
        "openai",
        "models",
        "tools"
      ],
      "minSeroVersion": "0.10.0-beta.0",
      "requiredHostCapabilities": [
        "ui.admin.model-settings",
        "ui.chat.model-extension",
        "appAgent.invokeTool",
        "tool.cli"
      ],
      "bundleExtensions": true,
      "preBuilt": false,
      "runtimeAbi": 3
    }
  },
  "dependencies": {
    "typebox": "^1.1.37"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.0.2",
    "@earendil-works/pi-ai": ">=1.0.2",
    "@earendil-works/pi-coding-agent": ">=1.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@module-federation/vite": "1.21.6",
    "@sero-ai/app-runtime": "^0.5.0",
    "@sero-ai/plugin-vite": "^0.1.0",
    "@sero-ai/ui": "^0.5.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.19.11",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.11.1",
    "esbuild": "^0.25.12",
    "jsdom": "^27.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.0.18"
  },
  "main": "index.js",
  "author": "",
  "license": "ISC"
}
